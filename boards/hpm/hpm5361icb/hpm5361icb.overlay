#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/hpm5361-clocks.h>
#include "dt-bindings/pinctrl/hpmicro-pinctrl-common.h"
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    aliases {
        booster-can = &mcan1;
        inter-can   = &mcan3;      /* 上下板通信总线（总线所有者组件用；与 user-can2 同一节点） */
        remote-uart = &uart1;
        hipnuc-uart = &uart0;   /* HiPNUC IMU：PA00/PA01（uart0），115200 8N1 */
        imu-spi     = &icm42688p;
        imu-pwm     = &imu_pwm;
        buzzer-pwm  = &buzzer_pwm;
        flash-spi   = &w25q128;
        pc-usb      = &qingyuusb_usb0;
    };

    chosen {
        zephyr,console = &uart2;
    };

    /* 弹丸检测输入（对射光电 / 微动开关）：PA18，每次上升沿 = 一发弹丸通过。
     * 放在 /zephyr,user 这个标准容器里：Zephyr 只给"有 compatible 的节点"和
     * /zephyr,user 生成属性宏，自造的无 compatible 节点（如 booster_shoot_irq）
     * 属性会被 devicetree 脚本丢掉，DT_PROP 取不到值。
     * booster 线程用 DT_PATH(zephyr_user) 取这个 gpio，注册上升沿中断
     * （见 thread/booster/trd_booster.cpp 的 ShootIrqIsr）。 */
    zephyr,user {
        booster-shoot-irq-gpios = <&gpioa 18 GPIO_ACTIVE_HIGH>;
    };

    pwm {
        compatible = "pwm-leds";

        imu_pwm: imu_pwm {
            pwms = <&pwm0 7 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "ICM42688P Heater";
            status = "okay";
        };

        buzzer_pwm: buzzer_pwm {
            pwms = <&pwm0 5 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "Buzzer";
            status = "okay";
        };

        pwm1_p2: pwm1_p2 {
            pwms = <&pwm1 2 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "PWM1 CH2";
            status = "okay";
        };

        pwm1_p3: pwm1_p3 {
            pwms = <&pwm1 3 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "PWM1 CH3";
            status = "okay";
        };
    };
};

&hdma {
    status = "okay";
};

&gpioa {
    pinctrl-0 = <&pinmux_gpioa>, <&pinmux_booster_shoot_irq>;
    pinctrl-names = "default";
    status = "okay";
};

&pinctrl {
    /* PA18 弹丸检测输入：IOC ALT0 = GPIO，内置下拉，
     * 传感器没插 / 线断了读 0，不会悬空误触发上升沿计数。
     * ⚠️ PA18 原本给 PWM1 CH2（见文件末尾 &pwm1），这里把它让给弹丸检测，
     *    &pwm1 的 pinctrl 只剩 PA19（CH3）。 */
    pinmux_booster_shoot_irq: pinmux_booster_shoot_irq {
        group0 {
            pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 18), IOC_TYPE_IOC, 0, 0)>;
            bias-pull-down;
        };
    };
};

&gpiob {
    pinctrl-0 = <&pinmux_gpiob_spi>;
    pinctrl-names = "default";
    status = "okay";
};

&gpioy {
    pinctrl-0 = <&pinmux_gpioy>;
    pinctrl-names = "default";
    status = "okay";
};

&mcan0 {
    pinctrl-0 = <&pinmux_mcan0_txrx>;
    pinctrl-names = "default";
    /* 位时序要精确：CAN 时钟必须能被 1Mbps 整除。
     * 原来 PLL1_CLK0(792MHz)/5 = 158.4MHz，SDK 只能取 158 tq 近似
     *   → prescaler=1, tq=158, seg1=119, seg2=39 → 实际 1.0025 Mbps（+0.25%）
     * 改成 OSC24M/1 = 24MHz：
     *   → prescaler=1, tq=24, seg1=18, seg2=6 → 精确 1.000 Mbps，采样点 75% */
    // clk-source = <CLK_SRC_OSC24M>;
    // clk-divider = <1>;
    bitrate = <1000000>;
    status = "okay";
};

/* ---- MCAN1 / MCAN2 / MCAN3 -------------------------------------------
 * SoC 节点（reg/irq/clk）与 pinctrl 已下沉到板级公共定义：
 *   Zephyr_HPMicro/sdk_glue_user/boards/hpmicro/hpm5361icb/
 *     hpm5361icb.dts          -> mcan1/2/3 + uart2 的 soc 节点、&mcanX/&uart2 引脚与 status=disabled
 *     hpm5361icb-pinctrl.dtsi -> pinmux_mcan1/2/3_txrx、pinmux_uart2
 * 工程侧只负责"启用 + 速率"：
 *   mcan1 = user-can2 = inter-can（上下板通信）
 *   mcan2 = user-can3，mcan3 = user-can4
 */
&mcan1 {
    bitrate = <1000000>;
    status = "okay";
};

&mcan2 {
    bitrate = <1000000>;
    status = "okay";
};

&mcan3 {
    /* 上下板通信总线 owner（thread/inter_bus 用的 inter-can）。
     * 位率必须与下板逐项一致（下板在 board_dm_mc02 的 &fdcan2 里）：
     *   仲裁段 1Mbps @ 采样点 80%，数据段 2Mbps @ 采样点 75%。
     * ⚠️ bitrate-data / sample-point(-data) 只在 CONFIG_CAN_FD_MODE=y 时才会被
     *    HPM 驱动用上（见 hpm5361icb.conf 里那段说明），否则 DBTP 根本不被编程。 */
    bitrate = <1000000>;
    sample-point = <800>;
    bitrate-data = <1000000>;
    sample-point-data = <750>;
    status = "okay";
};

&uart0 {
    /* PA00 = UART0_TXD / PA01 = UART0_RXD（板级 pinmux_uart0，IOC ALT2）
     * 速率/引脚/DMA 都在板级 hpm5361icb.dts 里：115200 8N1，DMA 0/1（0x14/0x15）
     * （uart3 已停用，它原来的 4/5 通道给了 console uart2，所以 0/1 现在只归 uart0） */
    current-speed = <115200>;
    status = "okay";
};

&uart1 {
    current-speed = <921600>;
    pinctrl-0 = <&pinmux_uart1>;
    pinctrl-names = "default";
    dmas = <&hdma 6 0x16>, <&hdma 7 0x17>;
    dma-names = "rx", "tx";
    status = "okay";
};

&uart4 {
    current-speed = <100000>;
    pinctrl-0 = <&pinmux_uart4_rx>;
    pinctrl-names = "default";
    uart-idle-gptmr-reg = <0xF000C000>;
    uart-idle-gptmr-clock-name = <CLOCK_GPTMR3>;
    dmas = <&hdma 2 0x1C>, <&hdma 3 0x1D>;
    dma-names = "rx", "tx";
    status = "okay";
};

/* ---- UART2（console，板载 "UART2"/H4 连接器）--------------------------
 * 连接器侧：H4.1 = +5V，H4.2 = GND（TVS 到 GND，F11/F12 串在数据线上）
 *           H4.3 = 板侧 RXD，H4.4 = 板侧 TXD
 * MCU 侧 ：PB09 = UART2_RXD，PB08 = UART2_TXD（IOC ALT2）
 *
 * soc 节点（0xF0048000 / IRQ15+IRQ5）、pinctrl、DMA、921600 都已在板级
 * hpm5361icb.dts 中定义；工程侧只额外挂 idle-gptmr 做接收空闲中断。
 */
&uart2 {
    /* 用 GPTMR3 做接收空闲定时器（idle line 中断） */
    uart-idle-gptmr-reg = <0xF000C000>;
    uart-idle-gptmr-clock-name = <CLOCK_GPTMR3>;
    status = "okay";
};

qingyuusb_usb0: &usb0 {
    compatible = "hpmicro,hpm-qingyuusb";
    clk-name = <CLOCK_USB0>;
    status = "okay";
};

&spi1 {
    pinctrl-0 = <&pinmux_spi1>;
    pinctrl-names = "default";
    clocks = <&clk CLOCK_SPI1 CLK_SRC_OSC24M 1>;
    status = "okay";

    w25q128: w25q128@0 {
        compatible = "winbond,w25q128";
        reg = <0>;
        spi-max-frequency = <50000000>;
        status = "okay";
    };
};

&spi2 {
    pinctrl-0 = <&pinmux_spi2_local>;
    pinctrl-names = "default";
    clocks = <&clk CLOCK_SPI2 CLK_SRC_OSC24M 1>;
    status = "okay";

    icm42688p: icm42688p@0 {
        compatible = "invensense,icm4268x";
        reg = <0>;
        spi-max-frequency = <100000>;
        int-gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
};

&pwm0 {
    pinctrl-0 = <&pinmux_pwm0_p57>;
    pinctrl-names = "default";
    period-init = <1000>;
    dead-zone-in-half-cycle = <0>;
    status = "okay";
};

&mtimer {
    compatible = "riscv,machine-timer", "andestech,machine-timer";
    reg-names = "mtime", "mtimecmp";
};

&pwm1 {
    /* PA18 改作弹丸检测输入（/zephyr,user 的 booster-shoot-irq-gpios），
     * 这里只剩 PA19 = PWM1 CH3。要用 CH2 的话得把检测脚挪回别的 pin。 */
    pinctrl-0 = <&pinmux_pwm1_p3>;
    pinctrl-names = "default";
    period-init = <1000>;
    dead-zone-in-half-cycle = <0>;
    status = "okay";
};
